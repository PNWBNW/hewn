{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PROJECT_DIR:-.}/scripts/sleep/snapshot.py\" consolidate",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PROJECT_DIR:-.}/scripts/sleep/snapshot.py\" wake",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
