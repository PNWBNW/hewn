# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code local settings (never commit)
.claude/settings.local.json
# The consolidation snapshot a session writes before its context is compacted (docs/SLEEP.md)
.claude/sleep/

# Secrets — never commit (the secrets scan, scripts/check_secrets.py, reads what isn't ignored)
.env
.env.*
!.env.example
*.pem
*.key
# Vercel's local link and pulled settings (`vercel link`, `vercel env pull`)
.vercel/
# A saved copy of the books (books/save_file.ts): encrypted, but a business's own, never the repository's
*.hewn
*.hewn.txt

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Accidental installs at the master level
node_modules/

# Build output
.next/
*.tsbuildinfo

# The static bundle of the app (HEWN_STATIC=1)
apps/business/out/
# The art prototypes' generated check page and its output (docs/art/prototype/README.md)
docs/art/prototype/check.html
docs/art/prototype/out/
# The map's built site (docs/map/README.md): published by .github/workflows/map.yml
docs/map/dist/

# Python bytecode (the sleep tests import their module)
__pycache__/
