    {
      "path": "src/ref/hqc-5/parameters.h",
      "sha256": "56543f11db813182627454fe71a35c4d4eb967e71baa22a46178f324a05cb193",
      "upstream_sha256": "de04f2f4c69e38b1618697da0a01ec9825d4d949c425f5e17064e0395f46b6ca",
      "patch": {
        "find": "#define BITMASK(a, size)  ((1UL << (a % size)) - 1)",
        "replace": "#define BITMASK(a, size)  ((1ULL << (a % size)) - 1)",
        "reason": "BITMASK shifts 1UL, an unsigned long, left by PARAM_N % 64, which is 37 for HQC-5. An unsigned long is 64 bits on the 64-bit systems the reference is built for but 32 bits on wasm32, where a shift by 37 is undefined and the mask comes out wrong: built unpatched, the module's public keys, ciphertexts and shared secrets all differ from the official KATs. 1ULL is at least 64 bits on every target, so the mask is the intended 2^37 - 1 everywhere, and the same as before on 64-bit systems. (For HQC-1 and HQC-3 the shift is 5 and 11, so they don't meet the bug.)"
      }
    },
