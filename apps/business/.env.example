# Copy to .env.local (gitignored). Every variable here is optional: the app runs with none of them.

# The mailbox (docs/THREAT_MODEL.md "The mailbox"): the pinning key the one server function uses
# to pass sealed documents between the two parties of an agreement. Server-side only, never sent
# to the browser. Unset: /api/mailbox answers 503 and everything else works.
PINATA_JWT=

# Optional: a dedicated gateway host for mailbox reads (e.g. books.mypinata.cloud).
# Default: the public gateway, gateway.pinata.cloud.
PINATA_GATEWAY=
